# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here is committed with real values. See docs/SETUP-GOOGLE.md.

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Comma-separated Google accounts allowed to sign in. Everyone else is refused.
ALLOWED_EMAILS=

# Optional. Defaults shown.
# HQ_TIMEZONE=America/Chicago
# Set to 0 to skip the Gmail read scope (inbox previews turn into plain Gmail links).
# HQ_GMAIL_PREVIEW=1
# Pin the Drive folder that holds the numbered context folders, instead of finding it by name.
# DRIVE_CONTEXT_FOLDER_ID=
# Public site shown in the football room.
# WARROOM_URL=https://www.hawkswarroom.com
# Optional Slack deep links (workspace URL like https://yourteam.slack.com).
# SLACK_WORKSPACE_URL=

# Legacy /classic app only (unchanged from the original project).
# ANTHROPIC_API_KEY=
